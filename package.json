{
  "name": "@haruhimemoe/invites",
  "version": "0.1.0",
  "description": "Invites as consent: zod schemas for invites and their terms, a pure state machine (pending, countered, accepted, declined, withdrawn, cancelled, expired), resend cooldowns, blocks, rate limits, reminder gating and inbox grouping. No dependencies besides zod.",
  "keywords": [
    "invite",
    "invites",
    "consent",
    "state machine",
    "reminders",
    "osu",
    "osu!",
    "tournament",
    "zod"
  ],
  "homepage": "https://github.com/haruhimemoe/invites#readme",
  "bugs": "https://github.com/haruhimemoe/invites/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haruhimemoe/invites.git"
  },
  "license": "MIT",
  "author": "David (https://dvh.sh)",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "bun@1.4.2",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "bun run clean && tsc -p tsconfig.build.json",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:dist": "bun run build && node scripts/smoke.mjs",
    "check:consumer": "bun run build && node scripts/check-consumer.mjs",
    "prepublishOnly": "bun run check && bun run typecheck && bun run test && bun run test:dist"
  },
  "peerDependencies": {
    "zod": "^4.0.16"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "26.6.2",
    "@vitest/coverage-v8": "5.0.1",
    "typescript": "7.0.2",
    "vitest": "5.0.1",
    "zod": "4.6.5"
  }
}
